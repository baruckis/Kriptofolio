{
  "schema_version": 1,
  "baseline_version": "1.0.0",
  "baseline_sha256": "0a1af61a6a2136a3b615ee38e3a253f22bb6076dfbadabc27f8378f61fe0e8bc",
  "repository": "baruckis/Kriptofolio",
  "default_branch": "master",
  "instructions": [
    "AGENTS.md"
  ],
  "review_instructions": "config/review-rules.md",
  "verification": [
    {
      "id": "build",
      "when": "application or build configuration changes",
      "command": "./gradlew assembleFullDebug assembleDemoDebug"
    },
    {
      "id": "unit",
      "when": "application code changes",
      "command": "./gradlew testFullDebugUnitTest"
    },
    {
      "id": "lint",
      "when": "application code changes",
      "command": "./gradlew lintFullDebug"
    }
  ],
  "cleanup": "AGENTS.md"
}
