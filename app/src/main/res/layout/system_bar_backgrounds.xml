<!-- The two strips that paint the areas behind the system bars.

     Until Android 15 the platform painted them, from the theme, and Window.setStatusBarColor
     could recolour the status bar at runtime. Apps that target Android 16 no longer get either:
     the window always extends behind the bars and both setters are no operations. So the app
     paints those areas itself.

     Both views are zero height in the layout on purpose. BaseActivity gives them the height the
     system reports for each bar, which is zero on Android 14 and below, where the decor view
     still keeps the window inside the bars and nothing needs painting. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <View
        android:id="@+id/status_bar_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/colorForStatusBarBackground" />

    <View
        android:id="@+id/navigation_bar_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@color/colorForNavigationBarBackground" />

</merge>
